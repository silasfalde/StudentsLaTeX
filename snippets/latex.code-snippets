    },
    "Corollary Box": {
        "scope": "latex",
        "prefix": "cor",
        "body": [
            "\\begin{corollary}[${1:Name}]",
            "    $0",
            "\\end{corollary}"
        ],
        "description": "Boxed corollary"
    },
    "Example Box": {
        "scope": "latex",
        "prefix": "exm",
        "body": [
            "\\begin{example}[${1:Name}]",
            "    $0",
            "\\end{example}"
        ],
        "description": "Boxed example"
    },
    "Remark Box": {
        "scope": "latex",
        "prefix": "rmk",
        "body": [
            "\\begin{remark}",
            "    $0",
            "\\end{remark}"
        ],
        "description": "Boxed remark (unnumbered)"
    },
    "Note Box": {
        "scope": "latex",
        "prefix": "nte",
        "body": [
            "\\begin{note}",
            "    $0",
            "\\end{note}"
        ],
        "description": "Boxed note (unnumbered)"
    },
    "Warning Box": {
        "scope": "latex",
        "prefix": "wrn",
        "body": [
            "\\begin{warning}",
            "    $0",
            "\\end{warning}"
        ],
        "description": "Boxed warning (unnumbered)"
    },
    "Proof": {
        "scope": "latex",
        "prefix": "prf",
        "body": [
            "\\begin{proof}",
            "    $0",
            "\\end{proof}"
        ],
        "description": "Proof ending with a green square"
    }
}
