{
    // Global/workspace LaTeX snippets. Every entry is scoped to "latex" so it
    // does not interfere with other languages when installed globally.
    // Placeholders: ${1:text} is a tab stop, $0 is the final cursor position,
    // and a backslash must be written as \\ (two as \\\\).

    // ---- Documents ----
    "Initialize Notes Document": {
        "scope": "latex",
        "prefix": "notes",
        "body": [
            "\\documentclass{notes}",
            "",
            "\\class{${1:Class ID}}",
            "\\title{${2:Class name}}",
            "\\author{${3:Your Name}}",
            "% Optional: \\subtitle{} \\instructor{} \\term{} \\titlelogo{}",
            "",
            "\\begin{document}",
            "\\maketitle",
            "\\tableofcontents",
            "",
            "\\chapter{${4:Chapter}}",
            "$0",
            "",
            "\\end{document}"
        ],
        "description": "Initialize a LaTeX notes document"
    },
    "Initialize Cheat Sheet Document": {
        "scope": "latex",
        "prefix": "cheatsheet",
        "body": [
            "\\documentclass[compact,columns=${1:3}]{notes}",
            "",
            "\\begin{document}",
            "",
            "\\chapter{${2:Chapter}}",
            "$0",
            "",
            "\\end{document}"
        ],
        "description": "Initialize a compact multi-column notes document for exam cheat sheets"
    },
    "Initialize Assignment Document": {
        "scope": "latex",
        "prefix": "assignment",
        "body": [
            "\\documentclass{assignment}",
            "",
            "\\class{${1:Class ID}}",
            "\\title{${2:Title}}",
            "\\author{${3:Your Name}}",
            "",
            "\\begin{document}",
            "\\maketitle",
            "",
            "\\section{${4:Problem Set}}",
            "\\begin{problem}",
            "    ${5:Problem statement.}",
            "\\end{problem}",
            "\\begin{solution}",
            "    $0",
            "\\end{solution}",
            "",
            "\\end{document}"
        ],
        "description": "Initialize a LaTeX assignment document"
    },
    "Initialize Essay Document": {
        "scope": "latex",
        "prefix": "essay",
        "body": [
            "\\documentclass{essay}",
            "",
            "\\class{${1:Class ID}}",
            "\\title{${2:Title}}",
            "\\author{${3:Your Name}}",
            "",
            "\\begin{document}",
            "\\maketitle",
            "",
            "\\section{${4:Introduction}}",
            "$0",
            "",
            "\\end{document}"
        ],
        "description": "Initialize a LaTeX essay document"
    },
    "Initialize Presentation Document": {
        "scope": "latex",
        "prefix": "presentation",
        "body": [
            "\\documentclass{presentation}",
            "",
            "\\title{${1:Title}}",
            "\\author{${2:Your Name}}",
            "\\institute{${3:Institution}}",
            "",
            "\\begin{document}",
            "",
            "\\begin{frame}",
            "    \\titlepage",
            "\\end{frame}",
            "",
            "\\section{${4:Section}}",
            "",
            "\\begin{frame}{${5:Frame title}}",
            "    $0",
            "\\end{frame}",
            "",
            "\\end{document}"
        ],
        "description": "Initialize a Beamer presentation document"
    },
    "Initialize Cover Letter": {
        "scope": "latex",
        "prefix": "coverletter",
        "body": [
            "\\documentclass{coverletter}",
            "",
            "\\signature{${1:Your Name}}",
            "\\address{${2:Street Address} \\\\ ${3:City, State ZIP}}",
            "",
            "\\begin{document}",
            "",
            "\\begin{letter}{${4:Hiring Manager} \\\\ ${5:Company} \\\\ ${6:Company Address}}",
            "",
            "    \\opening{Dear ${7:Hiring Manager},}",
            "",
            "        ${8:Opening paragraph connecting your background to the role.}",
            "",
            "        ${9:Paragraph describing your most relevant experience and accomplishments.}",
            "",
            "        ${10:Paragraph connecting your skills to the organization's needs.}",
            "",
            "        ${11:Closing paragraph expressing interest and requesting an interview.}",
            "",
            "    \\closing{${12:Sincerely,}}",
            "",
            "\\end{letter}",
            "",
            "\\end{document}",
            "$0"
        ],
        "description": "Initialize a cover letter using the coverletter document class"
    },

    // ---- Boxed environments (studentboxes) ----
    "Definition Box": {
        "scope": "latex",
        "prefix": "defn",
        "body": [
            "\\begin{definition}[${1:Name}]",
            "    $0",
            "\\end{definition}"
        ],
        "description": "Boxed definition"
    },
    "Theorem Box": {
        "scope": "latex",
        "prefix": "thm",
        "body": [
            "\\begin{theorem}[${1:Name}]",
            "    $0",
            "\\end{theorem}"
        ],
        "description": "Boxed theorem"
    },
    "Lemma Box": {
        "scope": "latex",
        "prefix": "lem",
        "body": [
            "\\begin{lemma}[${1:Name}]",
            "    $0",
            "\\end{lemma}"
        ],
