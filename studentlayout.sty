\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{studentlayout}[2026/10/08 v1.0 Shared metadata, title page, headers, and headings]

\RequirePackage{studentstyle}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{geometry}

% Document metadata (an empty default title avoids the "No \title given" error
% when the running header is used without one)
\renewcommand{\@title}{}
\newcommand{\@class}{}
\newcommand{\class}[1]{\renewcommand{\@class}{#1}}
\newcommand{\@titlelogo}{}
\newcommand{\titlelogo}[1]{\renewcommand{\@titlelogo}{#1}}
\newcommand{\@subtitle}{}
\newcommand{\subtitle}[1]{\renewcommand{\@subtitle}{#1}}
\newcommand{\@instructor}{}
\newcommand{\instructor}[1]{\renewcommand{\@instructor}{#1}}
\newcommand{\@term}{}
\newcommand{\term}[1]{\renewcommand{\@term}{#1}}

% Full title page. Use as \renewcommand{\maketitle}{\StudentsTitlePage}.
\newcommand{\StudentsTitlePage}{{%
    \thispagestyle{empty}
    \centering
    \vspace*{1cm}

    \ifx\@titlelogo\@empty\else
      \@titlelogo
      \vspace{1cm}
    \fi

    \ifx\@class\@empty\else
      {\Large\scshape\color{studentsaccent}\@class\par}
      \vspace{0.4cm}
    \fi

    {\color{studentsaccent}\rule{0.6\textwidth}{1pt}\par}
    \vspace{0.5cm}
    {\Huge\bfseries\@title\par}
    \ifx\@subtitle\@empty\else
      \vspace{0.3cm}
      {\Large\itshape\@subtitle\par}
    \fi
    \vspace{0.5cm}
    {\color{studentsaccent}\rule{0.6\textwidth}{1pt}\par}
    \vspace{0.8cm}

    {\Large\@author\par}
    \ifx\@instructor\@empty\else
      \vspace{0.3cm}
      {\large Instructor: \@instructor\par}
    \fi
    \ifx\@term\@empty\else
      \vspace{0.2cm}
      {\large\@term\par}
    \fi

    \vfill

    {\large\@date\par}
    \clearpage
    \setcounter{page}{1}
  }}

% Running header: class on the left, title on the right, green rule, and a
% centered page number. Pages that carry their own title block can use the
% footer-only style `studentsfirst`.
\newcommand{\StudentsRunningHeader}{%
  \geometry{headheight=26pt}%
  \pagestyle{fancy}%
  \fancyhf{}%
  \fancyhead[L]{\small\scshape\@class}%
  \fancyhead[R]{\small\itshape\@title}%
  \fancyfoot[C]{\small\thepage}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\headrule}{\hbox to\headwidth{%
    \color{studentsaccent}\leaders\hrule height \headrulewidth\hfill}}%
  \renewcommand{\footrulewidth}{0pt}%
}
\fancypagestyle{studentsfirst}{%
  \fancyhf{}%
  \fancyfoot[C]{\small\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
}

% Section headings: sections in the full accent colour, deeper levels in the
% softer one. #1, #2 are the section and subsection font sizes.
\newcommand{\StudentsHeadings}[2]{%
  \titleformat{\section}[block]
    {\normalfont#1\bfseries\color{studentsaccent}}
    {\thesection}{1em}{}%
  \titleformat{\subsection}[block]
    {\normalfont#2\bfseries\color{studentsaccentsoft}}
    {\thesubsection}{1em}{}%
  \titleformat{\subsubsection}[block]
    {\normalfont\normalsize\bfseries\itshape\color{studentsaccentsoft}}
    {\thesubsubsection}{1em}{}%
}

\endinput
